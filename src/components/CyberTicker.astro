<section class="cyber-ticker" data-cyber-ticker aria-label="U.S. cybersecurity updates">
  <div class="cyber-ticker__head">
    <strong>U.S. Cybersecurity Updates</strong>
    <button type="button" data-ticker-pause aria-pressed="false" hidden>Pause scrolling</button>
  </div>
  <p class="cyber-ticker__status"><a href="#cyber-archive-title">Search past reports</a></p>
  <div class="cyber-ticker__window" data-ticker-window hidden>
    <div class="cyber-ticker__track" data-ticker-track>
      <ul class="cyber-ticker__list" data-ticker-list></ul>
      <ul class="cyber-ticker__list" data-ticker-copy aria-hidden="true" hidden></ul>
    </div>
  </div>
  <p class="cyber-ticker__status" data-ticker-status>Loading public reports…</p>
  <p class="cyber-ticker__sources">
    Selected sources: <a href="https://oag.ca.gov/privacy/databreach/list">California DOJ</a> ·
    <a href="https://www.atg.wa.gov/data-breach-notifications">Washington AG</a> ·
    <a href="https://justice.oregon.gov/consumer/databreach/">Oregon DOJ</a> ·
    <a href="https://ago.vermont.gov/categories/security-breach-notices">Vermont AG</a> ·
    <a href="https://www.cisa.gov/news-events/cybersecurity-advisories">CISA</a> ·
    <a href="https://www.cisa.gov/known-exploited-vulnerabilities-catalog">CISA KEV</a> ·
    <a href="#cyber-source-bank">See all sources</a>
  </p>
  <noscript><style>.cyber-ticker [data-ticker-status]{display:none}</style></noscript>
</section>

<script>
  import './cyber-ticker-client.js';
</script>

<style is:global>
  .cyber-ticker { color:#f4f2ef; background:#171717; border-block:1px solid #36312e; min-width:0; max-width:100%; }
  .cyber-ticker [hidden] { display:none !important; }
  .cyber-ticker__head { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:.25rem 1rem; padding:.25rem .9rem; }
  .cyber-ticker__head strong { font-size:.9rem; }
  .cyber-ticker button { min-height:44px; padding:.25rem .65rem; color:inherit; background:transparent; border:1px solid #9b8172; border-radius:.3rem; cursor:pointer; }
  .cyber-ticker__window { overflow:hidden; }
  .cyber-ticker__track { display:flex; width:max-content; }
  .cyber-ticker__list { flex:none; display:flex; margin:0; padding:0; list-style:none; }
  .cyber-ticker__list li { flex:none; }
  .cyber-ticker__list a { display:flex; align-items:center; gap:.2rem .65rem; flex-wrap:wrap; min-height:44px; padding:.25rem .9rem; border-inline-end:1px solid #45403c; max-width:min(28rem, 84vw); color:inherit; text-decoration:none; overflow-wrap:anywhere; font-size:.85rem; }
  .cyber-ticker__list a:hover .cyber-ticker__title { text-decoration:underline; }
  .cyber-ticker__tag,.cyber-ticker__date { font: .7rem ui-monospace, monospace; }
  .cyber-ticker__tag { color:#f1a373; }
  .cyber-ticker__date,.cyber-ticker__status,.cyber-ticker__sources { color:#c5beb9; }
  .cyber-ticker a:focus-visible,.cyber-ticker button:focus-visible { outline:2px solid #f1a373; outline-offset:-3px; }
  .cyber-ticker__status,.cyber-ticker__sources { font-size:.75rem; margin:.3rem .9rem; overflow-wrap:anywhere; }
  .cyber-ticker__status a,.cyber-ticker__sources a { color:inherit; text-decoration:underline; }
  .cyber-ticker[data-moving] .cyber-ticker__track { animation:cyber-ticker-scroll var(--cyber-ticker-duration) linear infinite; }
  .cyber-ticker[data-manual] .cyber-ticker__window { overflow:auto; }
  @media (hover:hover) {
    .cyber-ticker__window:hover .cyber-ticker__track { animation-play-state:paused; }
  }
  @media (prefers-reduced-motion:reduce) {
    .cyber-ticker[data-moving] .cyber-ticker__track { animation:none; }
    .cyber-ticker__window { overflow:auto; }
    .cyber-ticker [data-ticker-copy] { display:none !important; }
  }
  @keyframes cyber-ticker-scroll { to { transform:translateX(-50%); } }
</style>
