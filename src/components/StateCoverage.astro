---
import coverage from '../data/stateCyberCoverage.json';
const modes = { automatic: 'Automatic', periodic: 'Periodic', unavailable: 'Unavailable' };
const count = (key: string) => coverage.filter((row) => row.status === key).length;
const sorted = [...coverage].sort((a,b)=>a.state.localeCompare(b.state));
---
<section id="state-coverage" class="state-coverage" aria-labelledby="state-coverage-title">
  <h2 id="state-coverage-title">State breach notice coverage</h2>
  <p>All 50 states and the District of Columbia, audited <time datetime="2026-11-21">November 21, 2026</time>. The table tracks official notice registers, not where an incident occurred. A missing feed does not mean a state had no incidents.</p>
  <div class="state-coverage__summary" aria-label="Audit totals">
    <span><strong>{count('automatic')}</strong> Automatic</span>
    <span><strong>{count('periodic')}</strong> Periodic</span>
    <span><strong>{count('unavailable')}</strong> Unavailable for current ingest</span>
  </div>
  <p><strong>Automatic:</strong> the ticker checks the register through our shared cache. <strong>Periodic:</strong> the archive contains a reviewed import or sample, not an automatic feed. <strong>Unavailable:</strong> no usable current statewide public register was verified. Some rows still link to older archives or reporting instructions.</p>
  <div class="state-coverage__filters" hidden>
    <label>Find a state<input type="search" data-state-query placeholder="State name or code"></label>
    <label>Connection<select data-state-mode><option value="">All statuses</option><option value="automatic">Automatic</option><option value="periodic">Periodic</option><option value="unavailable">Unavailable</option></select></label>
  </div>
  <p data-state-count role="status">51 jurisdictions</p>
  <table aria-label="Official breach notice sources by jurisdiction">
    <thead><tr><th scope="col">Jurisdiction</th><th scope="col">Connection</th><th scope="col">Newest date verified</th><th scope="col">Official source and finding</th></tr></thead>
    <tbody>{sorted.map((row) => (
      <tr data-state-row data-jurisdiction={row.state} data-state-code={row.code} data-mode={row.status}>
        <th scope="row">{row.state}</th>
        <td data-label="Connection"><span class:list={['state-coverage__badge', row.status]}>{modes[row.status as keyof typeof modes]}</span></td>
        <td data-label="Newest date verified">{row.newest ? <time datetime={row.newest}>{row.newest}</time> : 'Not verified'}</td>
        <td data-label="Official source and finding"><a href={row.url} target="_blank" rel="noopener noreferrer">Official source<span class="state-sr-only"> for {row.state}</span></a><span class="state-note">{row.note}</span></td>
      </tr>
    ))}</tbody>
  </table>
  <p>Dates use the official source’s available date field as explained in each row. They are not comparable as attack dates. National incidents, federal filings, and media reports are listed separately.</p>
</section>
<script>
  const section = document.querySelector<HTMLElement>('.state-coverage');
  if (section) {
    const form = section.querySelector<HTMLElement>('.state-coverage__filters');
    const query = section.querySelector<HTMLInputElement>('[data-state-query]');
    const mode = section.querySelector<HTMLSelectElement>('[data-state-mode]');
    const count = section.querySelector<HTMLElement>('[data-state-count]');
    const rows = Array.from(section.querySelectorAll<HTMLElement>('[data-state-row]'));
    if (form && query && mode && count) {
      form.hidden = false;
      const filter = () => {
        const q = query.value.toLowerCase().trim();
        let visible = 0;
        for (const row of rows) {
          row.hidden = !((!mode.value || row.dataset.mode === mode.value) && (!q || row.dataset.stateCode?.toLowerCase() === q || (row.dataset.jurisdiction ?? '').toLowerCase().includes(q)));
          if (!row.hidden) visible++;
        }
        count.textContent = visible === 0 ? 'No matching jurisdictions.' : `Showing ${visible} of ${rows.length} jurisdictions`;
      };
      query.addEventListener('input', filter);
      mode.addEventListener('change', filter);
    }
  }
</script>
<style>
  .state-coverage{margin-block:clamp(2.5rem,6vw,5rem);scroll-margin-top:1rem;overflow-wrap:anywhere}
  .state-coverage [hidden]{display:none!important}
  .state-coverage h2{font-size:clamp(1.8rem,5vw,3rem);line-height:1.1;margin:.3rem 0 .8rem}
  .state-coverage p{line-height:1.55;margin:.7rem 0;color:#ded4cd;max-width:82ch}
  .state-coverage__summary{display:flex;flex-wrap:wrap;gap:.5rem 1rem;margin:1rem 0}
  .state-coverage__summary span{border:1px solid #655043;border-radius:.35rem;padding:.4rem .65rem;font-size:.85rem}
  .state-coverage strong{color:#f1a373}
  .state-coverage__filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:.75rem;margin-block:1rem}
  .state-coverage__filters label{display:grid;gap:.2rem;color:#ded4cd}
  .state-coverage input,.state-coverage select{font:inherit;width:100%;min-width:0;min-height:44px;box-sizing:border-box;border:1px solid #776052;border-radius:.35rem;background:#201c19;color:#f4f0ec;color-scheme:dark;padding:.35rem .65rem}
  .state-coverage table{width:100%;border-collapse:collapse;font-size:.88rem;color:#f4f0ec}
  .state-coverage th,.state-coverage td{text-align:left;vertical-align:top;border-bottom:1px solid #493a32;padding:.65rem .55rem}
  .state-coverage thead th{color:#e6c2ab;background:#211b18}
  .state-note{display:block;color:#ded4cd;margin:.1rem 0 0}
  .state-coverage__badge{font: .74rem ui-monospace,monospace;color:#e3d1c7}
  .state-coverage__badge.automatic{color:#f1a373}
  .state-coverage a{display:inline-flex;align-items:center;min-height:40px;color:#f4f0ec;text-decoration:underline}
  .state-coverage :is(a,input,select):focus-visible{outline:2px solid #f1a373;outline-offset:2px}
  .state-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:640px){
    .state-coverage table,.state-coverage tbody{display:block}
    .state-coverage thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
    .state-coverage tbody tr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin-bottom:.7rem;border:1px solid #493a32;border-radius:.35rem;padding:.4rem}
    .state-coverage tbody th,.state-coverage tbody td:last-child{grid-column:1/-1}
    .state-coverage th,.state-coverage td{border-bottom:0;padding:.25rem .35rem;min-width:0}
    .state-coverage td::before{display:block;content:attr(data-label);color:#e6c2ab;font-size:.7rem}
  }
</style>
