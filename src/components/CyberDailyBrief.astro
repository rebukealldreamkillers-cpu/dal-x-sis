---
import archive from '../../public/cybersecurity-data/archive-snapshot.json';
import { buildRollingBrief, cohort, mergeReporting } from './cyber-reporting-data.js';
const initial = buildRollingBrief(mergeReporting(archive));
---
<section id="daily-disclosure-summary" class="brief" aria-labelledby="daily-brief-title" data-cyber-daily>
  <p class="brief__kicker">Rolling 30-day briefing · <span data-rolling-period>{initial.period}</span></p>
  <h2 id="daily-brief-title">What changed in the last 30 days</h2>
  <p class="brief__headline" data-rolling-headline>{initial.headline}</p>
  <p class="brief__lede">A like-for-like look at published records from seven continuously monitored sources, compared with the preceding 30 days.</p>
  <div class="brief__top">
    <ul class="brief__stats" aria-label="Rolling disclosure counts">
      <li><strong data-rolling-current>{initial.current}</strong><span class="brief__stat-label">Records this period</span><span class="brief__stat-context" data-rolling-current-range>{initial.period}</span></li>
      <li><strong data-rolling-previous>{initial.previous}</strong><span class="brief__stat-label">Records in prior period</span><span class="brief__stat-context" data-rolling-prior-range>{initial.comparison}</span></li>
      <li><strong data-rolling-change>{initial.change === null ? 'N/A' : `${initial.change > 0 ? '+' : ''}${initial.change}%`}</strong><span class="brief__stat-label">Change in records</span><span class="brief__stat-context">Same source list</span></li>
    </ul>
    <figure class="brief__chart" data-rolling-chart hidden>
      <figcaption>Records per week in the current window</figcaption>
      <ol class="brief__bars" data-rolling-bars></ol>
    </figure>
  </div>
  <p class="brief__latest-meta" data-rolling-status>Using the saved archive until the live source check completes.</p>
  <details class="brief__notes">
    <summary>How the rolling comparison works</summary>
    <p>Uses the last 30 completed reporting days and the 30 days before them, in Eastern time. Today is shown in the latest check below, not in the comparison. Counts use the date a record became public, not the date an attack occurred.</p>
    <p><strong>Sources:</strong> {Object.values(cohort).join(', ')}. Counts reflect records DAL-X has collected. Backfills, changes in publisher coverage and delayed feeds can move the numbers. Notices from different regulators can describe the same incident.</p>
  </details>
  <div class="brief__latest">
    <span class="brief__pulse" aria-hidden="true"></span>
    <div>
      <p class="brief__latest-copy"><b>Latest check.</b> <span data-daily-copy aria-live="polite">Checking the latest public disclosures.</span></p>
      <p class="brief__latest-meta"><span data-daily-detail hidden></span> <span data-daily-record hidden></span> <span data-daily-time>Reporting days use Eastern Time</span></p>
    </div>
  </div>
</section>
<script>
  import './cyber-daily-brief-client.js';
</script>
<style is:global>
.brief{margin-top:1.25rem;padding:clamp(1.1rem,3vw,2.1rem);border-radius:.6rem;background:radial-gradient(120% 90% at 100% 0%,rgba(208,80,16,.14),transparent 55%),#141211;border:1px solid #3c302a;color:#f2ebe6;min-width:0;overflow-wrap:anywhere}
.brief [hidden]{display:none!important}
.brief__kicker{font:.72rem/1.4 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:#f09a63;margin:0}
.brief h2{font-size:.95rem;font-weight:600;letter-spacing:.01em;color:#cbbdb3;margin:.35rem 0 0}
.brief__headline{font-size:clamp(1.7rem,4.6vw,3rem);font-weight:800;line-height:1.05;letter-spacing:-.035em;margin:.5rem 0 .7rem;color:#fff;max-width:22ch}
.brief__lede{font-size:clamp(1rem,2vw,1.15rem);line-height:1.55;color:#ddd1c8;max-width:62ch;margin:0}
.brief__top{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:clamp(1rem,3vw,2rem);align-items:end;margin:1.6rem 0 1.4rem}
.brief__stats{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}
.brief__stats li{display:flex;flex-direction:column;gap:.2rem;padding:.2rem 0 .2rem .8rem;border-inline-start:2px solid #d0501099}
.brief__stats strong{font-size:clamp(1.9rem,4.4vw,3rem);line-height:1;font-weight:800;letter-spacing:-.04em;color:#f6a26d}
.brief__stat-label{font-size:.86rem;font-weight:600;color:#f2ebe6;line-height:1.3}
.brief__stat-context{font-size:.76rem;color:#bfb0a6;line-height:1.35}
.brief__chart{margin:0;min-width:0}
.brief__chart figcaption{font:.7rem/1.4 ui-monospace,monospace;color:#bfb0a6;letter-spacing:.06em;text-transform:uppercase;margin-bottom:.5rem}
.brief__bars{list-style:none;margin:0;padding:0;height:120px;display:grid;grid-template-columns:repeat(var(--rolling-weeks,5),minmax(0,1fr));gap:6px;align-items:end;border-bottom:1px solid #4a3b33}
.brief__bars li{position:relative;height:100%;display:flex;align-items:end;justify-content:center;outline:none;cursor:default}
.brief__bar{display:block;width:100%;height:var(--h);min-height:3px;border-radius:3px 3px 0 0;background:#5c4a40;transition:background .15s}
.brief__bars li.is-peak .brief__bar{background:#e86020}
.brief__bars li.is-partial .brief__bar{background:repeating-linear-gradient(135deg,#5c4a40 0 4px,#3b2f29 4px 8px)}
.brief__bars li:is(:hover,:focus-visible) .brief__bar{background:#f6a26d}
.brief__bars li:focus-visible{box-shadow:0 0 0 2px #f6a26d;border-radius:3px}
.brief__week{position:absolute;top:calc(100% + .3rem);font:.6rem ui-monospace,monospace;color:#a99a90;white-space:nowrap}
.brief__bars li:nth-child(even) .brief__week{display:none}
.brief__tip{position:absolute;bottom:calc(var(--h) + 8px);left:50%;transform:translateX(-50%);display:none;z-index:2;background:#f6d2b9;color:#1a120d;border-radius:.3rem;padding:.35rem .5rem;font-size:.72rem;line-height:1.3;white-space:nowrap;pointer-events:none}
.brief__tip b{font-size:.9rem}.brief__tip em{display:block;font-style:normal;font-weight:600}
.brief__bars li:first-child .brief__tip{left:0;transform:none}.brief__bars li:last-child .brief__tip,.brief__bars li:nth-last-child(2) .brief__tip{left:auto;right:0;transform:none}
.brief__bars li:is(:hover,:focus-visible) .brief__tip{display:block}
.brief__takeaways{list-style:none;margin:1.6rem 0 0;padding:0;border-top:1px solid #3c302a}
.brief__takeaways li{border-bottom:1px solid #3c302a}
.brief__takeaways summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.85rem 0;cursor:pointer;font-size:.98rem;line-height:1.45;color:#e9e0d9;min-height:44px}
.brief__takeaways summary::-webkit-details-marker{display:none}
.brief__takeaways summary b{color:#fff}
.brief__takeaways summary:hover b{color:#f6a26d}
.brief__more{flex:none;width:.6rem;height:.6rem;border-right:2px solid #f09a63;border-bottom:2px solid #f09a63;transform:rotate(45deg);transition:transform .15s;margin-right:.2rem}
.brief__takeaways details[open] .brief__more{transform:rotate(225deg)}
.brief__takeaways details p{margin:-.25rem 0 .95rem;font-size:.9rem;line-height:1.6;color:#cdbfb5;max-width:72ch}
.brief__notes{margin-top:1rem}
.brief__notes summary{cursor:pointer;color:#f09a63;font-size:.85rem;padding:.4rem 0;min-height:44px;display:flex;align-items:center}
.brief__notes p{font-size:.82rem;line-height:1.6;color:#bfb0a6;max-width:85ch;margin:.2rem 0 .6rem}
.brief__latest{display:flex;gap:.7rem;align-items:flex-start;margin-top:.9rem;padding:.75rem .9rem;border-radius:.45rem;background:#1e1916;border:1px solid #3c302a}
.brief__pulse{flex:none;width:.55rem;height:.55rem;margin-top:.45rem;border-radius:50%;background:#e86020;box-shadow:0 0 0 0 rgba(232,96,32,.55);animation:brief-pulse 2.4s infinite}
@keyframes brief-pulse{70%{box-shadow:0 0 0 .45rem rgba(232,96,32,0)}100%{box-shadow:0 0 0 0 rgba(232,96,32,0)}}
@media (prefers-reduced-motion:reduce){.brief__pulse{animation:none}}
.brief__latest-copy{margin:0;font-size:.86rem;line-height:1.5;color:#e2d7cf}
.brief__latest-meta{margin:.15rem 0 0;font-size:.76rem;line-height:1.5;color:#ad9e94}
.brief__latest-meta a{color:#f4b88f}
.brief :is(summary,a,li[tabindex]):focus-visible{outline:2px solid #f6a26d;outline-offset:2px}
@media(max-width:820px){.brief__top{grid-template-columns:minmax(0,1fr)}}
@media(max-width:520px){.brief__stats{grid-template-columns:minmax(0,1fr);gap:.8rem}.brief__stats li{flex-direction:row;flex-wrap:wrap;align-items:baseline;gap:.2rem .6rem}.brief__stat-context{flex-basis:100%}}
</style>
