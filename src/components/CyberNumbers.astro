---
import archive from '../../public/cybersecurity-data/archive-snapshot.json';
import { buildNumbers } from './cyber-numbers-data.js';
const data=buildNumbers(archive);
const initial=data.windows[90];
const labels=[['reviewed','Reviewed entries','Editorial reports and campaign write-ups.'],['agent','AI agent security','A subset of reviewed entries, not an additional total.'],['public','Public records','Notices, filings, advisories, and catalog entries.']];
const serialized=JSON.stringify(data).replace(/</g,'\\u003c');
---
<section id="the-numbers" class="cyber-numbers" aria-labelledby="numbers-title" data-cyber-numbers>
  <header class="numbers-head">
    <div><p class="numbers-kicker">Disclosure trends</p><h2 id="numbers-title">The numbers</h2></div>
    <p class="numbers-date">Published archive through <time datetime={data.asOf}>{data.asOf}</time></p>
  </header>
  <p class="numbers-intro">See how reviewed incidents and public reports appear over time. These are disclosure volumes in the DAL-X archive, not counts of attacks or affected organizations.</p>
  <div class="numbers-kpis">
    {labels.map(([key,label,desc])=><div class="numbers-kpi"><div class="numbers-number" data-figure={key}>{initial.series[key].total.toLocaleString('en-US')}</div><strong>{label}</strong><p>{desc}</p></div>)}
  </div>
  <div class="numbers-panel" data-numbers-interactive hidden>
    <div class="numbers-toolbar">
      <label>Show<select data-numbers-scope><option value="reviewed">Reviewed entries</option><option value="agent">AI agent security</option><option value="public">Public records</option></select></label>
      <label>Date range<select data-numbers-window><option value="30">Last 30 days</option><option value="60">Last 60 days</option><option value="90" selected>Last 90 days</option></select></label>
    </div>
    <div class="numbers-visual">
      <div class="numbers-plot">
        <h3 data-numbers-chart-title>Reviewed entries by week</h3>
        <p class="numbers-help" id="numbers-instruction">Hover, tab to, or tap a week for the breakdown and source links.</p>
        <div class="numbers-chart-grid">
        <div class="numbers-scale" aria-hidden="true"><span data-numbers-ceiling></span><span data-numbers-middle></span><span>0</span></div>
        <div class="numbers-bars" role="group" aria-describedby="numbers-instruction" data-numbers-bars></div>
        </div>
        <ul class="numbers-legend" data-numbers-legend aria-label="Chart categories"></ul>
      </div>
      <aside class="numbers-detail" aria-labelledby="numbers-detail-title">
        <p class="numbers-kicker">Selected week</p><h3 id="numbers-detail-title" data-numbers-detail-title></h3>
        <p data-numbers-detail-count aria-live="polite"></p>
        <ul data-numbers-detail-list></ul>
        <div data-numbers-examples></div>
      </aside>
    </div>
    <details class="numbers-table"><summary>View the data table</summary><table data-numbers-table></table></details>
    <button class="numbers-download" type="button" data-numbers-download>Download this view as CSV</button>
  </div>
  <noscript><p>Enable JavaScript to explore weekly breakdowns, or use the published archive for source records.</p></noscript>
  <details class="numbers-method"><summary>How these numbers are counted</summary>
    <p>Each row in the published archive is counted once by its filing, publication, or catalog date, not the date an attack happened. Reviewed entries are a separate view. AI agent security is a subset of reviewed entries. Campaigns may cover multiple organizations, and notices from different regulators may cover the same incident.</p>
    <p>Weeks start Monday and use UTC dates. Partial weeks are marked with an asterisk. Differences can reflect publishing schedules, source coverage, and backfills. The live ticker can show newer reports before they enter the published archive. Do not use this chart as a measure of attack frequency.</p>
  </details>
  <script type="application/json" is:inline data-numbers-json set:html={serialized}></script>
</section>
<script>
  import './cyber-numbers-client.js';
</script>
<style is:global>
.cyber-numbers{margin-block:clamp(2.5rem,6vw,5rem);scroll-margin-top:1rem;min-width:0;color:#f4f0ec;overflow-wrap:anywhere;--chart-0:#ef995f;--chart-1:#b7b0aa;--chart-2:#a66a48;--chart-3:#d9c5b8;--chart-4:#72665f}
.cyber-numbers [hidden]{display:none!important}
.numbers-head{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:.8rem 2rem;border-bottom:1px solid #453830;padding-bottom:.8rem}
.numbers-kicker,.numbers-date,.numbers-help,.numbers-table th,.numbers-legend,.numbers-scale{font:.76rem/1.5 ui-monospace,monospace;color:#d2c3b8}
.numbers-kicker{color:#ef995f;letter-spacing:.1em;text-transform:uppercase;margin:0 0 .35rem}
.cyber-numbers .numbers-head h2{font-size:clamp(2rem,5vw,3.65rem);margin:0;letter-spacing:-.045em}
.numbers-date{margin:0}
.numbers-intro{max-width:78ch;color:#e0d5cd;line-height:1.55;margin:.9rem 0 1rem}
.numbers-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;margin:1rem 0}
.numbers-kpi{border:1px solid #463730;border-top:2px solid #b86b43;background:#1c1917;padding:clamp(.55rem,2vw,1rem);border-radius:.4rem;min-width:0}
.numbers-kpi strong{display:block;font-size:.84rem}.numbers-kpi p{color:#d2c3b8;font-size:.75rem;line-height:1.4;margin:.35rem 0 0}
.numbers-number{font:700 clamp(1.5rem,4vw,2.8rem)/1.05 ui-monospace,monospace;color:#f4af82;letter-spacing:-.05em;margin-bottom:.3rem}
.numbers-panel{background:#191614;border:1px solid #463730;border-radius:.55rem;min-width:0;padding:clamp(.65rem,2vw,1.2rem)}
.numbers-toolbar{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:1.1rem}
.numbers-toolbar label{display:grid;gap:.25rem;font-size:.82rem;color:#ded4cc;flex:0 1 14rem;min-width:0}
.numbers-toolbar select,.numbers-download{min-height:44px;background:#211c19;color:#f4f0ec;border:1px solid #7d6050;border-radius:.35rem;padding:.3rem .6rem;font:inherit;color-scheme:dark;max-width:100%}
.numbers-visual{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);gap:.9rem;align-items:start}
.numbers-plot{position:relative;min-width:0;padding:.55rem .35rem .45rem .2rem}.numbers-help{margin:.35rem 0 .6rem}
.numbers-plot h3,.numbers-detail h3{font-size:1.1rem;line-height:1.3;margin:0}
.numbers-bars{height:clamp(155px,26vw,255px);display:grid;grid-template-columns:repeat(var(--week-count),minmax(0,1fr));gap:clamp(1px,1vw,8px);border-bottom:1px solid #927361;background:repeating-linear-gradient(to top,transparent 0,transparent calc(50% - 1px),#48382f calc(50% - 1px),#48382f 50%);position:relative}
.numbers-chart-grid{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.35rem}.numbers-scale{pointer-events:none;display:flex;flex-direction:column;justify-content:space-between;text-align:right;font-size:.66rem;line-height:1}
.numbers-bar{border:0;background:transparent;color:#f4f0ec;position:relative;display:flex;justify-content:center;align-items:end;padding:0 .08rem;min-width:0;font:inherit;cursor:pointer;touch-action:manipulation}
.numbers-stack{display:flex;flex-direction:column-reverse;justify-content:flex-start;width:100%;max-width:3.2rem;height:var(--bar-height);min-height:2px;background:#68574e;border-radius:.18rem .18rem 0 0;overflow:hidden}
.numbers-bar[aria-pressed=true] .numbers-stack,.numbers-bar:hover .numbers-stack{outline:1px solid #ffe0cc;outline-offset:1px}
.numbers-segment,.numbers-swatch{background:var(--tone);display:block}.numbers-axis{position:absolute;top:100%;left:50%;transform:translateX(-50%);white-space:nowrap;font:.62rem/1.5 ui-monospace,monospace;color:#decabd;padding-top:.3rem;pointer-events:none}
.numbers-bar:nth-child(3n+2) .numbers-axis,.numbers-bar:nth-child(3n+3) .numbers-axis{display:none}
.numbers-bar:nth-last-child(2) .numbers-axis,.numbers-bar:nth-last-child(3) .numbers-axis{display:none}.numbers-bar:last-child .numbers-axis{display:block;left:auto;right:0;transform:none}
.numbers-tip{display:none;z-index:1;position:absolute;bottom:calc(var(--bar-height) + .3rem);right:0;background:#f5c8a9;color:#16110e;padding:.24rem .38rem;border-radius:.2rem;white-space:nowrap;font:.72rem ui-monospace,monospace;pointer-events:none}
.numbers-bar:first-child .numbers-tip{right:auto;left:0}.numbers-bar:is(:hover,:focus-visible) .numbers-tip{display:block}
.numbers-legend{margin:2rem 0 0;padding:0;display:flex;flex-wrap:wrap;gap:.38rem .85rem;list-style:none}.numbers-legend li{display:flex;align-items:center;gap:.3rem}.numbers-swatch{height:.7rem;width:.7rem;border:1px solid #ae8c77;border-radius:.12rem;flex:none}
.numbers-detail{padding:.85rem;min-width:0;background:#231c18;border:1px solid #4b382e;border-radius:.4rem;font-size:.84rem;line-height:1.5}
.numbers-detail p{margin:.4rem 0}.numbers-detail ul{margin:.38rem 0 .7rem;padding:0;list-style:none}.numbers-detail li{display:flex;justify-content:space-between;gap:.6rem;border-bottom:1px solid #493a32;padding:.28rem 0}
.numbers-detail a{display:block;padding:.35rem 0;line-height:1.4;color:#f8c6a7}.numbers-detail a small{display:block;color:#d9c9bf}
.numbers-table,.numbers-method{margin-top:.85rem}.numbers-table summary,.numbers-method summary{cursor:pointer;padding:.6rem 0;color:#f2b189}.numbers-method p{color:#d2c3b8;line-height:1.55;max-width:85ch}
.numbers-table table{border-collapse:collapse;width:100%;text-align:left;font-size:.82rem}.numbers-table :is(th,td){padding:.35rem;border-bottom:1px solid #493a32}.numbers-table td{color:#e8d9cf}
.numbers-download{cursor:pointer;margin:.55rem 0 0}.cyber-numbers :is(button,select,a,summary):focus-visible{outline:2px solid #f4af82;outline-offset:2px}
@media(max-width:720px){.numbers-visual{grid-template-columns:minmax(0,1fr)}.numbers-kpis{gap:.37rem}.numbers-kpi p{font-size:.7rem}.numbers-axis{font-size:.55rem}}
@media(max-width:480px){.numbers-toolbar label{flex:1 1 105px}.numbers-kpi strong{font-size:.73rem}.numbers-table thead{position:absolute;clip:rect(0,0,0,0);height:1px;width:1px;overflow:hidden}.numbers-table tbody tr{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #493a32}.numbers-table tbody th{grid-column:1/-1}.numbers-table td::before{content:attr(data-label);display:block;font-size:.65rem;color:#d2c3b8}}
</style>
