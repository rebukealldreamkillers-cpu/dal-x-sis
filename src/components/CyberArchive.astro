<section class="cyber-archive" data-cyber-archive aria-labelledby="cyber-archive-title">
  <div class="cyber-archive__intro">
    <p class="cyber-archive__label">Searchable history / 90-day window</p>
    <h2 id="cyber-archive-title">Browse the reports</h2>
    <p>Search organizations, headlines, sources, or CVE IDs. Dates reflect when a report was filed or published, or when CISA added a vulnerability to its catalog.</p>
  </div>
  <div class="cyber-archive__controls" hidden>
    <label class="cyber-archive__search">Search reports<input type="search" data-filter="query" placeholder="Organization, headline, or CVE ID"></label>
    <label>Topic<select data-filter="topic"><option value="">All topics</option><option value="ai-agent-security">AI agent security</option></select></label>
    <label>Type<select data-filter="kind"><option value="">All types</option><option value="incident">National incident</option><option value="breach">Breach notice</option><option value="filing">SEC filing</option><option value="agency">Law enforcement announcement</option><option value="advisory">Advisory</option><option value="kev">Exploited vulnerability</option></select></label>
    <label>Source<select data-filter="source"><option value="">All sources</option></select></label>
    <label>Period<select data-filter="days"><option value="90">Last 90 days</option><option value="30">Last 30 days</option><option value="7">Last 7 days</option></select></label>
  </div>
  <p class="cyber-archive__coverage" data-archive-freshness>Searching the published archive. Checking the latest public reports…</p>
  <p class="cyber-archive__status" role="status">Loading reports…</p>
  <ul class="cyber-archive__results"></ul>
  <button type="button" class="cyber-archive__more" hidden>Show more reports</button>
  <p class="cyber-archive__coverage">Includes sampled public records and reviewed national incidents. A single incident can appear as a state notice, an SEC filing, and a reviewed report. These are not counts of unique incidents.</p>
  <slot />
</section>
<script>
  import './cyber-archive-client.js';
</script>
<style is:global>
.cyber-archive {margin-block:clamp(2rem,5vw,4.5rem); color:#f4f0ec; min-width:0;}
.cyber-archive [hidden]{display:none!important;}
.cyber-archive__intro h2{margin:.2rem 0 .75rem;font-size:clamp(1.8rem,5vw,3rem);letter-spacing:-.04em;line-height:1.1;}
.cyber-archive__intro p:not(.cyber-archive__label),.cyber-archive__coverage{color:#cdc2b9;line-height:1.55;max-width:75ch;}
.cyber-archive__label,.cyber-archive__status,.cyber-archive__meta{font:.75rem ui-monospace,monospace;line-height:1.55;}
.cyber-archive__label,.cyber-archive__type{color:#f1a373;}
.cyber-archive__controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:.8rem;margin:1.35rem 0 .85rem;}
.cyber-archive__controls label{display:grid;align-content:start;gap:.35rem;color:#e1d6cc;font-size:.8rem;min-width:0;}
.cyber-archive__controls input,.cyber-archive__controls select,.cyber-archive__more{width:100%;min-width:0;min-height:44px;font:inherit;color:#f4f0ec;background:#201c19;border:1px solid #776052;border-radius:.35rem;padding:.5rem .65rem;box-sizing:border-box;color-scheme:dark;}
.cyber-archive input::placeholder{color:#c3b7ae;}
.cyber-archive a:focus-visible,.cyber-archive input:focus-visible,.cyber-archive select:focus-visible,.cyber-archive button:focus-visible,.cyber-archive li:focus{outline:2px solid #f1a373;outline-offset:2px;}
.cyber-archive__status{color:#ddd0c4;margin:1rem 0;}
.cyber-archive__results{margin:0;padding:0;list-style:none;border-top:1px solid #493a32;}
.cyber-archive__results li{display:grid;gap:.2rem;padding:.8rem .3rem;border-bottom:1px solid #493a32;overflow-wrap:anywhere;}
.cyber-archive__meta{display:flex;flex-wrap:wrap;gap:.15rem .6rem;color:#cfc2b7;}
.cyber-archive__results a{color:#f4f0ec;display:flex;align-items:center;min-height:44px;line-height:1.4;text-decoration:underline;text-underline-offset:.18em;text-decoration-color:#a47c66;}
.cyber-archive__results a:hover{text-decoration-color:#f1a373;}
.cyber-archive__more{width:auto;cursor:pointer;margin-top:1rem;}
.cyber-archive__coverage{font-size:.82rem;margin-top:1rem;}
</style>
