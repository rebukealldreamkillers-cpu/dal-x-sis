            </div>
            <div class="dalx-flow-connector">
              <div class="dalx-flow-line"></div>
              <div class="dalx-flow-arrowhead"></div>
            </div>
            <div class="dalx-flow-node dalx-flow-node--route">
              <p class="dalx-flow-node-label">Authority Routing</p>
              <p class="dalx-flow-node-sub">Principal mapping<br>Threshold match<br>Escalation path</p>
            </div>
            <div class="dalx-flow-connector">
              <div class="dalx-flow-line"></div>
              <div class="dalx-flow-arrowhead"></div>
            </div>
            <div class="dalx-flow-node dalx-flow-node--gate">
              <p class="dalx-flow-node-label">Execution Gate</p>
              <p class="dalx-flow-node-sub">Scope<br>Conformance<br>Acknowledgment</p>
            </div>
            <div class="dalx-flow-connector">
              <div class="dalx-flow-line"></div>
              <div class="dalx-flow-arrowhead"></div>
            </div>
            <div class="dalx-flow-node dalx-flow-node--record">
              <p class="dalx-flow-node-label">Decision Record</p>
              <p class="dalx-flow-node-sub">Pre-execution<br>Evidence capture<br>Authority stamp</p>
            </div>
            <div class="dalx-flow-connector">
              <div class="dalx-flow-line"></div>
              <div class="dalx-flow-arrowhead"></div>
            </div>
            <div class="dalx-flow-node dalx-flow-node--output">
              <p class="dalx-flow-node-label">Authorized Action</p>
