---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact Jochanni Labs"
  description="Contact Kevin Moore at Jochanni Labs to discuss Decision Governance, the DAL-X application, or a paid enterprise pilot."
>
  <div class="page-header">
    <div class="container">
      <p class="page-label">Jochanni Labs</p>
      <h1>Contact</h1>
      <p>Questions about Decision Governance, the DAL-X application, or a paid enterprise pilot.</p>
    </div>
  </div>

  <main class="contact-outer">
    <div class="container">
      <div class="contact-grid">

        <!-- ── Form ───────────────────────────────────────────────── -->
        <div class="contact-form-wrap">

          <div id="contact-success" class="contact-result contact-result--success" hidden>
            <p class="contact-result-heading">Message sent</p>
            <p>Kevin will reply to the email address you provided.</p>
          </div>

          <div id="contact-error" class="contact-result contact-result--error" hidden>
            <p class="contact-result-heading">Something went wrong</p>
            <p id="contact-error-msg">Please try again or email <a href="mailto:kevin@jochannilabs.com">kevin@jochannilabs.com</a> directly.</p>
          </div>

          <form id="contact-form" class="contact-form" novalidate>
            <!-- Honeypot: hidden from real users, bots fill it in -->
            <input type="text" name="_honey" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;" />

            <div class="form-group">
              <label class="form-label" for="name">Name</label>
              <input class="form-input" type="text" id="name" name="name" autocomplete="name" required placeholder="Your name" />
            </div>

            <div class="form-group">
              <label class="form-label" for="organization">
                Organization
                <span class="form-label-optional">(optional)</span>
              </label>
              <input class="form-input" type="text" id="organization" name="organization" autocomplete="organization" placeholder="Company or institution" />
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Email</label>
              <input class="form-input" type="email" id="email" name="email" autocomplete="email" required placeholder="you@example.com" />
            </div>

            <div class="form-group">
              <label class="form-label" for="subject">Subject</label>
              <select class="form-select" id="subject" name="subject" required>
                <option value="" disabled selected>Select a subject</option>
                <option value="Enterprise pilot">Enterprise pilot discussion</option>
                <option value="Decision Governance">Decision Governance</option>
                <option value="DAL-X application">DAL-X application</option>
                <option value="Strategic Intelligence Series">Strategic Intelligence Series</option>
                <option value="Press">Press inquiry</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Message</label>
              <textarea class="form-textarea" id="message" name="message" required placeholder="Describe what you would like to discuss."></textarea>
            </div>

            <div class="form-submit-row">
              <button id="contact-submit" type="submit" class="btn-primary">Send message</button>
              <span class="form-note">Sent to kevin@jochannilabs.com</span>
            </div>
          </form>

        </div>

        <!-- ── Sidebar ────────────────────────────────────────────── -->
        <aside class="contact-sidebar">

          <div class="contact-sidebar-card">
            <p class="contact-sidebar-label">Enterprise Pilot</p>
            <h3>Discuss a paid pilot</h3>
            <p>A small number of organizations are engaged in a paid pilot to run DAL-X enforcement in a live environment. Use the form or reach out directly.</p>
            <a href="mailto:kevin@jochannilabs.com" class="contact-direct-email">kevin@jochannilabs.com</a>
          </div>

          <div class="contact-sidebar-card">
            <p class="contact-sidebar-label">Inspect enforcement</p>
            <h3>DAL-X simulation</h3>
            <p>The current build runs end to end in a simulated enterprise environment. Production enforcement controls are still being completed.</p>
            <a href="https://simulation.dal-x.com/" class="contact-direct-email" target="_blank" rel="noopener noreferrer">simulation.dal-x.com</a>
          </div>

          <div class="contact-sidebar-card">
            <p class="contact-sidebar-label">Publication</p>
            <h3>Strategic Intelligence Series</h3>
            <p>Twenty briefings defining Decision Governance as the runtime authority discipline for consequential AI agent executions.</p>
            <a href="/briefings" class="contact-direct-email">dal-x.com/briefings</a>
          </div>

        </aside>

      </div>
    </div>
  </main>
</Base>

<script>
(function () {
  const form    = document.getElementById('contact-form')    as HTMLFormElement;
  const submit  = document.getElementById('contact-submit')  as HTMLButtonElement;
  const success = document.getElementById('contact-success') as HTMLElement;
  const errBox  = document.getElementById('contact-error')   as HTMLElement;
  const errMsg  = document.getElementById('contact-error-msg') as HTMLElement;

  if (!form) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submit.textContent = 'Sending…';
    submit.disabled = true;
    success.hidden = true;
    errBox.hidden = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: new FormData(form),
      });

      const payload = await res.json();

      if (payload.ok) {
        form.hidden = true;
        success.hidden = false;
      } else {
        errMsg.innerHTML = (payload.error ?? 'Something went wrong.') +
          ' Email <a href="mailto:kevin@jochannilabs.com">kevin@jochannilabs.com</a> directly.';
        errBox.hidden = false;
        submit.textContent = 'Send message';
        submit.disabled = false;
      }
    } catch {
      errMsg.innerHTML = 'Message failed to send. Email <a href="mailto:kevin@jochannilabs.com">kevin@jochannilabs.com</a> directly.';
      errBox.hidden = false;
      submit.textContent = 'Send message';
      submit.disabled = false;
    }
  });
})();
</script>
