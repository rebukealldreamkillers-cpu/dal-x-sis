---
import Base from '../layouts/Base.astro';
import CyberArchive from '../components/CyberArchive.astro';
import CyberTicker from '../components/CyberTicker.astro';
import CyberDailyBrief from '../components/CyberDailyBrief.astro';
import CyberNumbers from '../components/CyberNumbers.astro';
import CyberSourceBank from '../components/CyberSourceBank.astro';
import StateCoverage from '../components/StateCoverage.astro';
import reviewed from '../data/reviewedIncidents.json';
const topicLabel = (t: string) => t === 'ai-agent-security' ? 'AI agent security' : 'National cyber incident';
---
<Base title="U.S. Cybersecurity Updates" description="National cyber incident reporting and a searchable archive of public breach notices and federal advisories.">
  <main class="container cyber-updates-page">
    <header class="cyber-updates-intro">
      <p class="overline">Public reporting · A free resource from Jochanni Labs</p>
      <h1>U.S. Cybersecurity Updates</h1>
      <p class="cyber-updates-lede">One place to follow U.S. cyber incidents as they are disclosed, from first news report to official confirmation, with every entry linked to its original source.</p>
      <div class="cyber-updates-why">
        <div>
          <h2>What this is</h2>
          <p>DAL-X brings together breaking news, state breach notices, federal advisories, SEC filings, and incidents our editors have reviewed. Breaking reports usually appear within 30 minutes of publication.</p>
        </div>
        <div>
          <h2>How it helps you</h2>
          <p>When you need to brief a board, a client, or your team, start here. Reviewed incidents state what happened, who confirmed it, and what is still unknown. Everything is searchable.</p>
        </div>
        <div>
          <h2>Why Jochanni Labs publishes it</h2>
          <p>Jochanni Labs studies how organizations confirm an action is authorized before it runs, including actions taken by AI agents. Public incident records show where those controls hold and where they fail. We publish this so decision makers, risk teams, and technical teams can work from the same verified facts.</p>
        </div>
      </div>
      <p class="cyber-updates-note">This page reports public disclosures. It is not live attack telemetry.</p>
    </header>
    <CyberTicker />
    <CyberDailyBrief />
    <CyberNumbers />
    <section class="national" aria-labelledby="national-title"><p class="overline">Reviewed coverage</p><h2 id="national-title">National incidents</h2><p>Nationally reported U.S. incidents and consequential disclosures, reviewed separately from the automated feeds. Dates mark the linked coverage or disclosure, not when the intrusion began.</p><div class="national-filter" role="group" aria-label="Filter reviewed incidents" data-national-filter hidden><button type="button" aria-pressed="true" data-topic="">All</button><button type="button" aria-pressed="false" data-topic="national-cyber">National cyber incidents</button><button type="button" aria-pressed="false" data-topic="ai-agent-security">AI agent security</button><button type="button" aria-pressed="false" data-recent="14">Updated in last 14 days</button></div><ul data-national-list>
      {reviewed.map((c) => (
        <li id={c.id} data-topic={c.topic} data-updated={c.lastUpdated} class="national-card">
          <p class="national-meta"><time datetime={c.date}>{c.date}</time><span class="national-cat">{topicLabel(c.topic)}</span><span>{c.evidence}</span>{c.timeline.length > 1 && <span class="national-updated">Updated <time datetime={c.lastUpdated}>{c.lastUpdated}</time></span>}</p>
          <h3><a href={`#${c.id}`}>{c.title}</a></h3>
          <dl class="national-brief">
            <div><dt>What happened</dt><dd>{c.happened}</dd></div>
            <div><dt>What was affected</dt><dd>{c.affected}</dd></div>
            <div><dt>Who confirmed it</dt><dd>{c.confirmed}</dd></div>
            <div><dt>What is still unknown</dt><dd>{c.unknown}</dd></div>
          </dl>
          <div class="national-history">
            <p class="national-latest"><span>{c.timeline.length > 1 ? 'Latest update' : 'First disclosed'}</span> <time datetime={c.lastUpdated}>{c.lastUpdated}</time> · <b>{c.timeline[c.timeline.length - 1].kind}.</b> {c.timeline[c.timeline.length - 1].fact} <a href={c.timeline[c.timeline.length - 1].source.url} target="_blank" rel="noopener noreferrer">{c.timeline[c.timeline.length - 1].source.label}</a></p>
            {c.timeline.length > 1 && (
              <details>
                <summary>How this story developed ({c.timeline.length} updates)</summary>
                <ol class="national-timeline">
                  {[...c.timeline].reverse().map((t) => (
                    <li><time datetime={t.date}>{t.date}</time><div><b>{t.kind}.</b> {t.fact} <span class="national-by">Established by <a href={t.source.url} target="_blank" rel="noopener noreferrer">{t.source.label}</a></span></div></li>
                  ))}
                </ol>
              </details>
            )}
          </div>
          <p class="national-links"><span>Sources</span>{c.sources.map((src) => <a href={src.url} target="_blank" rel="noopener noreferrer">{src.label}</a>)}</p>
          <div class="national-actions">
            <button type="button" data-copy-brief>Copy briefing</button>
            <button type="button" data-copy-link>Copy link</button>
            <span class="national-copied" role="status" aria-live="polite"></span>
          </div>
          <script type="application/json" data-brief set:html={JSON.stringify(c).replace(/</g, '\\u003c')}></script>
        </li>
      ))}
    </ul></section>
    <CyberArchive />
    <StateCoverage />
    <CyberSourceBank />
  </main>
</Base>
<script>
  const labels = [['happened','What happened'],['affected','What was affected'],['confirmed','Who confirmed it'],['unknown','What is still unknown']];
  const pageUrl = 'https://www.dal-x.com/cybersecurity/';
  async function copyText(text, status) {
    try { await navigator.clipboard.writeText(text); status.textContent = 'Copied'; }
    catch { status.textContent = 'Copy failed. Select the text manually.'; }
    setTimeout(() => { status.textContent = ''; }, 2500);
  }
  for (const card of document.querySelectorAll('.national-card')) {
    const data = JSON.parse(card.querySelector('[data-brief]').textContent);
    const status = card.querySelector('.national-copied');
    card.querySelector('[data-copy-brief]').addEventListener('click', () => {
      const lines = [`${data.title} (${data.date})`, `Evidence: ${data.evidence}`, ...labels.map(([k, l]) => `${l}: ${data[k]}`),
        'Timeline:', ...[...data.timeline].map((t) => `  ${t.date}: ${t.kind}. ${t.fact} (${t.source.label})`), `Sources: ${data.sources.map((s) => `${s.label} ${s.url}`).join('; ')}`, `Via DAL-X US Cybersecurity Updates: ${pageUrl}#${data.id}`];
      copyText(lines.join('\n'), status);
    });
    card.querySelector('[data-copy-link]').addEventListener('click', () => copyText(`${pageUrl}#${data.id}`, status));
  }
  const target = location.hash && document.getElementById(location.hash.slice(1));
  if (target && target.classList.contains('national-card')) target.classList.add('is-target');
  const filter = document.querySelector('[data-national-filter]');
  if (filter) {
    const cards = Array.from(document.querySelectorAll('[data-national-list] > li'));
    filter.hidden = false;
    filter.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button) return;
      for (const b of filter.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === button));
      const cutoff = button.dataset.recent ? Date.now() - Number(button.dataset.recent) * 86_400_000 : 0;
      for (const card of cards) {
        const topicMiss = Boolean(button.dataset.topic) && card.dataset.topic !== button.dataset.topic;
        const recentMiss = cutoff && Date.parse(card.dataset.updated + 'T23:59:59Z') < cutoff;
        card.hidden = Boolean(topicMiss || recentMiss);
      }
    });
  }
</script>
<style is:global>
.cyber-updates-page{padding-block:clamp(2rem,6vw,5rem); min-width:0}
.cyber-updates-intro{margin-bottom:1.5rem}
.cyber-updates-intro h1{font-size:clamp(2rem,7vw,4.6rem);line-height:1.05;margin:.5rem 0 1rem;overflow-wrap:anywhere}
.cyber-updates-intro p{color:#cdc2b9;max-width:70ch;line-height:1.55;margin:.45rem 0}
.cyber-updates-lede{font-size:clamp(1.05rem,2.2vw,1.25rem);color:#ece3dc!important;max-width:62ch!important}
.cyber-updates-why{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(.75rem,2vw,1.5rem);margin:1.4rem 0 .6rem;padding-top:1.1rem;border-top:1px solid #3c302a}
.cyber-updates-why h2{font-size:.78rem;font-family:ui-monospace,monospace;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#f09a63;margin:0 0 .45rem;line-height:1.4}
.cyber-updates-why p{font-size:.92rem;margin:0;color:#d6cac1}
.cyber-updates-note{font:.74rem/1.5 ui-monospace,monospace!important;color:#a99a90!important;margin-top:.8rem!important}
@media(max-width:760px){.cyber-updates-why{grid-template-columns:minmax(0,1fr)}}
.cyber-updates-page .overline{font:.75rem ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:#f1a373}
.national-updated{color:#1a120d;background:#f6a26d;border-radius:999px;padding:0 .5rem;font-weight:600}
.national-updated time{color:inherit}
.national-history{margin:.2rem 0 .4rem;padding:.55rem .65rem;background:#231c18;border:1px solid #45362e;border-radius:.35rem}
.national-latest{margin:0!important;font-size:.84rem!important;line-height:1.5;color:#e9ded6!important}
.national-latest>span{font:.66rem ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:#f09a63}
.national-latest a,.national-timeline a{color:#f4b88f}
.national-history details{margin-top:.35rem}
.national-history summary{cursor:pointer;color:#f2b189;font-size:.8rem;min-height:40px;display:flex;align-items:center}
.national-timeline{list-style:none;margin:.2rem 0 0;padding:0 0 0 .2rem;border-left:2px solid #5a463b}
.national-timeline li{display:grid;grid-template-columns:5.6rem minmax(0,1fr);gap:.5rem;padding:.35rem 0 .35rem .6rem;font-size:.82rem;line-height:1.5;color:#dccfc6;position:relative}
.national-timeline li::before{content:'';position:absolute;left:-.38rem;top:.7rem;width:.55rem;height:.55rem;border-radius:50%;background:#e86020}
.national-timeline time{font:.72rem ui-monospace,monospace;color:#f09a63;padding-top:.1rem}
.national-by{display:block;color:#a99a90;font-size:.76rem}
@media(max-width:480px){.national-timeline li{grid-template-columns:minmax(0,1fr);gap:.1rem}}
.national-card{scroll-margin-top:1rem}
.national-card.is-target{outline:2px solid #e86020;outline-offset:2px}
.national ul[data-national-list]{grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))!important}
.national-card h3 a{color:inherit;text-decoration:none}.national-card h3 a:hover{text-decoration:underline;text-decoration-color:#e86020}
.national-meta .national-cat{color:#fff;background:#3a2a22;border-radius:999px;padding:0 .5rem}
.national-brief{margin:.6rem 0 .4rem;display:grid;gap:.55rem}
.national-brief div{border-left:2px solid #4b3a31;padding-left:.65rem}
.national-brief dt{font:.68rem/1.4 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:#f09a63;margin:0 0 .15rem}
.national-brief dd{margin:0;font-size:.86rem;line-height:1.5;color:#e2d7cf}
.national-links{display:flex;flex-wrap:wrap;align-items:center;gap:.1rem .7rem;font-size:.82rem}
.national-links>span{font:.66rem ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:#a99a90}
.national-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-top:.3rem}
.national-actions button{min-height:40px;padding:.3rem .75rem;border:1px solid #6d5546;border-radius:.3rem;background:transparent;color:#f2e7df;font:inherit;font-size:.8rem;cursor:pointer}
.national-actions button:hover{border-color:#e86020;color:#fff}
.national-actions button:focus-visible,.national-card h3 a:focus-visible{outline:2px solid #f6a26d;outline-offset:2px}
.national-copied{font:.72rem ui-monospace,monospace;color:#f6a26d}
.national-filter{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0 .2rem}.national-filter button{min-height:40px;padding:.35rem .8rem;border-radius:999px;border:1px solid #6d5546;background:#1c1816;color:#e9ded6;font:inherit;font-size:.82rem;cursor:pointer}.national-filter button[aria-pressed=true]{background:#d05010;border-color:#d05010;color:#fff}.national-filter button:focus-visible{outline:2px solid #f6a26d;outline-offset:2px}.national [hidden]{display:none!important}
.national{margin-block:clamp(2rem,5vw,4.5rem);min-width:0}.national h2{margin:.2rem 0 .75rem;font-size:clamp(1.8rem,5vw,3rem);letter-spacing:-.04em;line-height:1.1}.national p{max-width:76ch;line-height:1.55;color:#cdc2b9}.national .overline{color:#f1a373}.national ul{list-style:none;margin:1.1rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:.85rem}.national li{background:#1c1917;border:1px solid #493a32;border-radius:.45rem;padding:1rem;overflow-wrap:anywhere}.national h3{margin:.35rem 0 .4rem;font-size:1.05rem;line-height:1.35}.national li p{margin:.35rem 0;font-size:.85rem}.national li .national-meta{display:flex;flex-wrap:wrap;gap:.15rem .65rem;font:.7rem ui-monospace,monospace;color:#f1a373}.national-links a{display:inline-flex;align-items:center;min-height:44px;color:#f4f0ec;text-underline-offset:.18em}.national-links a:focus-visible{outline:2px solid #f1a373;outline-offset:2px}
</style>
