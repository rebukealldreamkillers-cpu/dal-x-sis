                <td>Funds or fees spent without permission.</td>
              </tr>
              <tr>
                <td>Locked-period ledger edit<sup><a href="#s2">2</a></sup></td>
                <td>Ledger write handler.</td>
                <td>Closed accounts changed without authorized review.</td>
              </tr>
              <tr>
                <td>Customer-profile update<sup><a href="#s7">7</a></sup></td>
                <td>Gateway and receiving mutation handler.</td>
                <td>An unauthorized record change could execute.</td>
              </tr>
