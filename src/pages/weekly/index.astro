---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Decision Governance Weekly"
  description="Weekly enforcement briefs by Jochanni Labs. What happened, where enforcement failed, and how DAL-X can enforce authority before execution."
>
  <div class="page-header">
    <div class="container">
      <div class="weekly-brandline">
        <img class="weekly-logo" src="/weekly/jochanni-labs-logo.jpg" alt="Jochanni Labs logo, a flame inside a shield" width="64" height="64" />
        <p class="page-label">Jochanni Labs</p>
      </div>
      <h1>Decision Governance Weekly</h1>
      <p>What happened. Where enforcement failed. How DAL-X can enforce authority before execution.</p>
    </div>
  </div>

  <main class="weekly-index-main">
    <div class="container">

      <a href="/weekly/lets-talk-about-it/" class="weekly-feature">
        <p class="weekly-feature-label">AI Execution Incidents / Updated daily</p>
        <p class="weekly-feature-title">Let's Talk About It</p>
        <p class="weekly-feature-desc">DAL-X enforcement opportunities in AI execution incidents worldwide. Every incident is drawn from public reporting. Opens the live dashboard.</p>
      </a>

      <div class="section-label" style="margin-top: 3rem;">Published Issues</div>

      <div class="weekly-index-list">

        <a href="/weekly/2026-10-12/" class="weekly-index-row">
          <div class="weekly-index-num">Issue 03</div>
          <div class="weekly-index-body">
            <p class="weekly-index-title">Decision Governance Weekly</p>
          </div>
          <div class="weekly-index-aside">
            <span class="weekly-index-date">12 Oct 2026</span>
            <span class="status-badge status-badge--published">Published</span>
          </div>
        </a>

        <a href="/weekly/2026-10-05/" class="weekly-index-row">
          <div class="weekly-index-num">Issue 02</div>
          <div class="weekly-index-body">
            <p class="weekly-index-title">Decision Governance Weekly</p>
          </div>
          <div class="weekly-index-aside">
            <span class="weekly-index-date">5 Oct 2026</span>
            <span class="status-badge status-badge--published">Published</span>
          </div>
        </a>

        <a href="/weekly/2026-10-04/" class="weekly-index-row">
          <div class="weekly-index-num">Issue 01</div>
          <div class="weekly-index-body">
            <p class="weekly-index-title">Decision Governance Weekly</p>
          </div>
          <div class="weekly-index-aside">
            <span class="weekly-index-date">4 Oct 2026</span>
            <span class="status-badge status-badge--published">Published</span>
          </div>
        </a>

      </div>

    </div>
  </main>
</Base>
