---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  ogImage?: string;
  publishedDate?: string;
  keywords?: string;
}

const {
  title,
  description = 'Decision Governance Strategic Intelligence Series — Decision Governance and Runtime Authority for AI-generated work.',
  type = 'website',
  ogImage,
  publishedDate,
  keywords = 'Decision Governance, DAL-X, runtime authority, AI governance, trigger logic, authority routing, execution gating, decision records, audit evidence, AI influenced decisions, AI generated work, Jochanni Labs',
} = Astro.props;

const siteBase = Astro.site ?? 'https://www.dal-x.com';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageURL = new URL(ogImage ?? '/og-image.svg', siteBase).toString();

const fullTitle = title === 'DAL-X'
  ? 'DAL-X — Strategic Intelligence Series'
  : title.includes('DAL-X')
    ? title
    : `${title} — DAL-X`;

const isHomepage = Astro.url.pathname === '/';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Kevin Moore" />
  <meta name="robots" content="index, follow" />
  <meta name="keywords" content={keywords} />

  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="DAL-X" />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content="Decision Governance Strategic Intelligence Series — Decision Governance and Runtime Authority" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {type === 'article' && publishedDate && (
    <>
      <meta property="article:published_time" content={publishedDate} />
      <meta property="article:author" content="Kevin Moore" />
    </>
  )}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content="Decision Governance Strategic Intelligence Series" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Jochanni Labs",
    "url": siteBase.toString(),
    "founder": { "@type": "Person", "name": "Kevin Moore" },
    "description": "Research organization developing the framework for Decision Governance and runtime authority in AI-influenced enterprise execution.",
    "sameAs": [],
  })} />

  {isHomepage && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Decision Governance Strategic Intelligence Series",
      "url": siteBase.toString(),
      "description": "A publication series defining Decision Governance as the runtime authority discipline for AI-influenced enterprise execution.",
      "author": { "@type": "Person", "name": "Kevin Moore" },
      "publisher": { "@type": "Organization", "name": "Jochanni Labs" },
    })} />
  )}

  {type === 'article' && publishedDate && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": fullTitle,
      "description": description,
      "datePublished": publishedDate,
      "author": { "@type": "Person", "name": "Kevin Moore" },
      "publisher": {
        "@type": "Organization",
        "name": "Jochanni Labs",
        "url": siteBase.toString(),
      },
      "url": canonicalURL.toString(),
      "image": ogImageURL,
    })} />
  )}
</head>
<body>
  <header class="masthead">
    <div class="container">
      <div class="masthead-brand-row">
        <a href="/" class="masthead-logo" aria-label="DAL-X">DAL</a>
        <span class="masthead-tagline">Strategic Intelligence Series</span>
      </div>
    </div>

    <nav class="masthead-nav-row" aria-label="Primary navigation">
      <div class="container">
        <div class="nav-items">
          <a href="/briefings"           aria-current={isActive('/briefings')           ? 'page' : undefined}>Briefings</a>
          <a href="/decision-governance" aria-current={isActive('/decision-governance') ? 'page' : undefined}>Decision Governance</a>
          <a href="/dal-x"              aria-current={isActive('/dal-x')              ? 'page' : undefined}>DAL-X</a>
          <a href="/about"              aria-current={isActive('/about')              ? 'page' : undefined}>About Kevin Moore</a>
          <a href="/jochanni-labs"      aria-current={isActive('/jochanni-labs')      ? 'page' : undefined}>Jochanni Labs</a>
        </div>
      </div>
    </nav>
  </header>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-inner">
        <span class="footer-copy">© {new Date().getFullYear()} Jochanni Labs</span>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/briefings">Briefings</a>
          <a href="/decision-governance">Decision Governance</a>
          <a href="/dal-x">DAL-X</a>
          <a href="/about">About</a>
          <a href="/jochanni-labs">Jochanni Labs</a>
        </nav>
      </div>
    </div>
  </footer>
</body>
</html>
