{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/cybersecurity-data/ticker-feed.json",
      "destination": "/api/cyber-ticker-feed"
    }
  ],
  "functions": {
    "api/cyber-ticker-feed.py": {
      "includeFiles": "public/cybersecurity-data/snapshot.json",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dal-x.com"
        }
      ],
      "destination": "https://www.dal-x.com/:path*",
      "permanent": true
    }
  ]
}
